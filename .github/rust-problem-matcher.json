{
  "problemMatcher": [
    {
      "owner": "rust-short",
      "pattern": [
        {
          "regexp": "^([^\\s:][^:]*):(\\d+):(\\d+):\\s+(warning|error)(?:\\[[^\\]]+\\])?:\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "message": 5
        }
      ]
    }
  ]
}
