#!/bin/sh
# The AppImage runtime starts this script, and this script starts Picto. The
# program, `ffmpeg`, `ffprobe` and the shared libraries that the program needs
# are in `usr/bin` beside this script.
set -e
here="$(dirname "$(readlink -f "$0")")"

# When Picto quits with a downloaded update waiting, the old version replaces
# its AppImage with the new one and runs the new one once with this variable
# set, and waits for it to end (`src/desktop/linux.rs`; the updater of Picto
# 0.6.19 and earlier does the same). Replacing the file was the whole
# installation, so
# there is nothing left to do, and the app must not start.
if [ "${APPIMAGE_EXIT_AFTER_INSTALL:-}" = "true" ]; then
	exit 0
fi

exec "$here/usr/bin/picto" "$@"
