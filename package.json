{
  "name": "picto",
  "productName": "Picto",
  "private": true,
  "version": "0.6.0-alpha",
  "description": "Media library manager",
  "author": "Picto <noreply@picto.app>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "prepare:viewer-assets": "node scripts/prepare-viewer-assets.mjs",
    "generate:app-icons": "node scripts/generate-app-icons.mjs",
    "generate:license-notices": "node scripts/generate-license-notices.mjs",
    "lock:onlyfans-sidecar": "uv pip compile scripts/onlyfans-bridge-requirements.in --universal --python-version 3.12 --output-file scripts/onlyfans-bridge-requirements.txt --no-annotate --no-header",
    "release:audit": "node scripts/release-audit.mjs",
    "predev": "npm run prepare:viewer-assets",
    "dev": "vite",
    "predev:electron": "npm run prepare:viewer-assets",
    "dev:electron": "concurrently -k -n vite,rust,electron -c cyan,red,green \"vite --host 127.0.0.1 --port 8080\" \"CARGO_PROFILE_DEV_DEBUG=0 cargo watch -w core/src -w core/Cargo.toml -w picto-library/src -w picto-library/Cargo.toml -w native/picto-node/src -w native/picto-node/Cargo.toml -s 'cd native/picto-node && ./node_modules/.bin/napi build' -d 1\" \"wait-on tcp:8080 && nodemon --signal SIGTERM --watch electron --watch native/picto-node/index.node --ext mjs,cjs,node --delay 1 --exec 'electron electron/main.mjs'\"",
    "start:electron": "npm run rebuild:native && electron electron/main.mjs",
    "rebuild:native": "cd native/picto-node && ./node_modules/.bin/napi build",
    "generate:bindings": "cargo run --manifest-path core/Cargo.toml --example export_bindings",
    "build:native": "cd native/picto-node && ./node_modules/.bin/napi build --release",
    "build:gallery-dl-bridge": "node -e \"const {spawnSync}=require('node:child_process'); const python=process.platform==='win32'?'python':'python3'; const result=spawnSync(python,['scripts/build-gallery-dl-bridge.py',...process.argv.slice(1)],{stdio:'inherit'}); process.exit(result.status ?? 1)\" --",
    "build:onlyfans-bridge": "node -e \"const {spawnSync}=require('node:child_process'); const python=process.platform==='win32'?'python':'python3'; const result=spawnSync(python,['scripts/build-onlyfans-bridge.py',...process.argv.slice(1)],{stdio:'inherit'}); process.exit(result.status ?? 1)\" --",
    "prebuild": "npm run prepare:viewer-assets",
    "build": "tsc && vite build && npm run generate:license-notices",
    "build:electron": "tsc && vite build && npm run generate:license-notices",
    "dist:electron": "electron-builder",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "alpha:verify": "npm run release:audit && npx tsc -p tsconfig.json --noEmit && npm run test -- --run && cargo test --manifest-path core/Cargo.toml --quiet && npm run check:command-parity",
    "alpha:package": "npm run generate:app-icons && npm run build:native && npm run build:electron && npm run build:gallery-dl-bridge && npm run build:onlyfans-bridge && npm run release:audit -- --artifacts && node scripts/build-alpha-package.mjs",
    "alpha:smoke": "node ./scripts/ci/alpha-smoke.mjs",
    "duplicate:smoke": "node ./scripts/ci/duplicate-review-smoke.mjs",
    "duplicate:benchmark": "node ./scripts/ci/duplicate-scan-benchmark.mjs",
    "subscriptions:verify-sites": "node ./scripts/verify-sites.mjs",
    "subscriptions:verify-mcp": "node ./scripts/subscription-verifier-mcp.mjs",
    "test:subscriptions:verify-mcp": "node --test ./scripts/subscription-verifier-mcp.test.mjs",
    "gate:alpha": "npm run alpha:verify",
    "check:command-parity": "node ./scripts/check-command-parity.mjs",
    "test:rust": "cargo test --manifest-path core/Cargo.toml"
  },
  "main": "electron/main.mjs",
  "build": {
    "productName": "Picto",
    "appId": "com.picto.desktop",
    "electronVersion": "43.4.1",
    "files": [
      "dist/assets/**/*",
      "dist/vendor/**/*",
      "dist/licenses/**/*",
      "dist/*.html",
      "electron/**/*",
      "native/picto-node/index.node",
      "!node_modules/**",
      "node_modules/electron-updater/**",
      "node_modules/builder-util-runtime/**",
      "node_modules/debug/**",
      "node_modules/ms/**",
      "node_modules/sax/**",
      "node_modules/fs-extra/**",
      "node_modules/graceful-fs/**",
      "node_modules/jsonfile/**",
      "node_modules/universalify/**",
      "node_modules/js-yaml/**",
      "node_modules/argparse/**",
      "node_modules/lazy-val/**",
      "node_modules/lodash.escaperegexp/**",
      "node_modules/lodash.isequal/**",
      "node_modules/semver/**",
      "node_modules/tiny-typed-emitter/**",
      "LICENSE",
      "THIRD_PARTY_LICENSES",
      "package.json"
    ],
    "asarUnpack": [
      "native/**/*.node"
    ],
    "extraFiles": [
      {
        "from": "vendor/ffmpeg/",
        "to": ".",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "ffprobe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "vendor/gallery-dl/",
        "to": "gallery-dl/",
        "filter": [
          "picto-gallery-dl-bridge",
          "picto-gallery-dl-bridge.exe",
          "THIRD_PARTY_LICENSES.txt"
        ]
      },
      {
        "from": "vendor/onlyfans/",
        "to": "onlyfans/",
        "filter": [
          "picto-onlyfans-bridge",
          "picto-onlyfans-bridge.exe",
          "THIRD_PARTY_LICENSES.txt"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "resources/tutorial/",
        "to": "tutorial/"
      },
      {
        "from": "build/library.ico",
        "to": "library-icons/library.ico"
      },
      {
        "from": "build/library.icns",
        "to": "library-icons/library.icns"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "midona-rhel",
      "repo": "picto"
    },
    "fileAssociations": [
      {
        "ext": "library",
        "name": "Picto Library",
        "icon": "library.icns",
        "role": "Editor",
        "rank": "Owner",
        "isPackage": true
      }
    ],
    "mac": {
      "icon": "build/Picto.icon",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "uninstallerIcon": null,
      "installerHeader": null
    },
    "linux": {
      "icon": "build/icon-flat.png",
      "maintainer": "Picto <noreply@picto.app>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@jsquash/jxl": "^1.3.0",
    "@office-kit/pptx": "^0.12.0",
    "@office-kit/pptx-preview": "^0.9.1",
    "@ruffle-rs/ruffle": "0.5.0",
    "djvu-rs": "^0.30.1",
    "docx-preview": "^0.4.0",
    "electron-updater": "^6.8.9",
    "jotai": "^2.18.1",
    "jszip": "^3.10.1",
    "marked": "^18.0.11",
    "pdfjs-dist": "^6.2.108",
    "rtf.js": "^3.0.9"
  },
  "devDependencies": {
    "@mantine/core": "^8.3.14",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@resvg/resvg-js": "2.6.2",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12",
    "jsdom": "^24.0.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1",
    "wait-on": "^8.0.5",
    "zod": "^4.4.3"
  },
  "allowScripts": {
    "electron": true
  }
}
