{
  "name": "picto",
  "productName": "Picto",
  "private": true,
  "version": "0.5.0-alpha",
  "description": "Media library manager",
  "author": "Picto <noreply@picto.app>",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:electron": "concurrently -k -n vite,rust,electron -c cyan,red,green \"vite --host 127.0.0.1 --port 8080\" \"cargo watch -w core/src -w native/picto-node/src -s 'cd native/picto-node && ./node_modules/.bin/napi build' -d 1\" \"wait-on tcp:8080 && nodemon --watch electron --watch native/picto-node/index.node --ext mjs,cjs,node --delay 1 --exec 'electron electron/main.mjs'\"",
    "start:electron": "npm run rebuild:native && electron electron/main.mjs",
    "rebuild:native": "cd native/picto-node && ./node_modules/.bin/napi build",
    "build:native": "cd native/picto-node && ./node_modules/.bin/napi build --release",
    "build": "tsc && vite build",
    "build:electron": "tsc && vite build",
    "dist:electron": "electron-builder",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:watch": "vitest --watch",
    "alpha:verify": "npx tsc -p tsconfig.json --noEmit && npm run test -- --run && cargo test --manifest-path core/Cargo.toml --quiet && npm run check:command-parity",
    "alpha:package": "npm run build:native && npm run build:electron && npx electron-builder --publish=never",
    "alpha:smoke": "node ./scripts/ci/alpha-smoke.mjs",
    "gate:alpha": "npm run alpha:verify",
    "check:command-parity": "node ./scripts/check-command-parity.mjs",
    "test:rust": "cargo test --manifest-path core/Cargo.toml",
    "profile:cpu": "bash ./scripts/profile-cpu.sh"
  },
  "main": "electron/main.mjs",
  "build": {
    "productName": "Picto",
    "appId": "com.picto.desktop",
    "electronVersion": "37.10.3",
    "files": [
      "dist/assets/**/*",
      "dist/*.html",
      "electron/**/*",
      "native/picto-node/index.js",
      "native/picto-node/index.node",
      "native/picto-node/index.*.node",
      "!node_modules/**",
      "node_modules/electron-updater/**",
      "node_modules/builder-util-runtime/**",
      "node_modules/debug/**",
      "node_modules/ms/**",
      "node_modules/sax/**",
      "node_modules/fs-extra/**",
      "node_modules/graceful-fs/**",
      "node_modules/jsonfile/**",
      "node_modules/universalify/**",
      "node_modules/js-yaml/**",
      "node_modules/argparse/**",
      "node_modules/lazy-val/**",
      "node_modules/lodash.escaperegexp/**",
      "node_modules/lodash.isequal/**",
      "node_modules/semver/**",
      "node_modules/tiny-typed-emitter/**",
      "LICENSE",
      "THIRD_PARTY_LICENSES",
      "package.json"
    ],
    "asarUnpack": [
      "native/**/*.node"
    ],
    "extraFiles": [
      {
        "from": "vendor/ffmpeg/",
        "to": ".",
        "filter": [
          "ffmpeg",
          "ffmpeg.exe",
          "ffprobe",
          "ffprobe.exe"
        ]
      },
      {
        "from": "vendor/gallery-dl/",
        "to": "gallery-dl/",
        "filter": [
          "**/*",
          "!*.whl"
        ]
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "midona-rhel",
      "repo": "picto"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "uninstallerIcon": null,
      "installerHeader": null
    },
    "linux": {
      "maintainer": "Picto <noreply@picto.app>",
      "target": [
        "AppImage"
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "jotai": "^2.18.1"
  },
  "devDependencies": {
    "@mantine/core": "^8.3.14",
    "@mantine/hooks": "^8.3.14",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-virtual": "^3.13.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.3.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^9.2.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "jsdom": "^24.0.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.3.3",
    "vite": "^5.0.12",
    "vitest": "^1.2.1",
    "wait-on": "^8.0.5"
  }
}
